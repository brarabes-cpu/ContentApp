flowchart TD
    A["Пользователь нажал<br/>'Сделать как я хочу' / 'Сделать как ты поняла'"] --> B{Статус пользователя?}

    B -->|Незарегистрирован| C["API endpoint: guest/unregistered<br/>(упрощённая/бесплатная модель)"]
    B -->|Авторизован| D["API endpoint: authorized<br/>(полноценная модель)"]

    C --> E[Получен результат]
    D --> F[Получен результат]

    E --> G{"WATERMARK_ENABLED<br/>(флаг в коде)"}
    G -->|true| H["Наложить водяной знак"]
    G -->|false| I["Результат без знака"]

    H --> J["Показать результат гостю<br/>+ баннер про регистрацию"]
    I --> J

    F --> K["Показать результат<br/>авторизованному пользователю"]

    style C fill:#fff8e1,stroke:#c9a227
    style D fill:#eef6ff,stroke:#3a7bd5
    style H fill:#ffe0e0,stroke:#c0392b
